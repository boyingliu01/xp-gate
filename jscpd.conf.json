{
  "$schema": "./node_modules/jscpd/json/schema/jscpd-schema.json",
  "ignore": [
    "**/__snapshots__/**",
    "**/__fixtures__/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/.stryker-tmp/**",
    "**/coverage/**",
    "**/.worktrees/**",
    "**/.perf-measure/**",
    "**/.xp-gate/**",
    "**/*.md",
    "**/src/npm-package/**",
    "**/.git/**",
    "**/.sprint-history/**",
    "**/githooks/adapters/gate-*.sh",
    "**/plugins/*/skills/**",
    "**/plugins/*/lib/**",
    "**/*/lib/client.js",
    "**/__tests__/**"
  ]
}
