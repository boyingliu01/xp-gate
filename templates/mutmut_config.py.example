"""
Mutmut configuration example for XP-Gate Python projects
Copy this file to mutmut_config.py and customize for your project
"""

import mutmut


def get_config():
    """
    Configure mutmut for your project.
    
    Returns:
        dict: Configuration options for mutmut
    """
    return {
        # Required: Command to run tests
        'command': 'pytest tests/',
        
        # Optional: Source directories to mutate
        'source_dirs': ['src/', 'lib/'],
        
        # Optional: Test directories
        'test_dirs': ['tests/', 'test/'],
        
        # Optional: Exclude patterns
        'exclude_dirs': ['src/migrations/', 'src/generated/'],
        
        # Optional: Number of parallel workers
        'n_workers': 4,
        
        # Optional: Custom test runner
        'runner': 'pytest',
        
        # Optional: Disable specific mutation types
        'disable': [
            # 'ArithmeticOperator',
            # 'EqualityOperator'
        ]
    }


# Alternative: Class-based configuration (for advanced use cases)
class MutmutConfig(mutmut.Config):
    """Advanced mutmut configuration with custom hooks."""
    
    def get_command(self):
        """Return the test command."""
        return 'pytest tests/ -v'
    
    def get_source_dirs(self):
        """Return source directories to mutate."""
        return ['src/', 'lib/']
    
    def get_test_dirs(self):
        """Return test directories."""
        return ['tests/', 'test/']
    
    def get_exclude_dirs(self):
        """Return directories to exclude."""
        return ['src/migrations/', 'src/generated/']
    
    def post_mutation_hook(self, filename):
        """
        Optional hook called after each mutation.
        
        Args:
            filename: The mutated file path
        """
        # Example: Log mutation progress
        print(f"Mutated: {filename}")
