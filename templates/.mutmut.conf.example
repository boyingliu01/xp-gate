[mutmut]
# Mutmut configuration example for XP-Gate Python projects
# Copy this file to .mutmut.conf and customize for your project

# Command to run tests (required)
# Default: pytest
command = pytest tests/

# Source directories to mutate (optional, defaults to current directory)
# source_dirs = src/,lib/

# Test directories (optional, defaults to tests/)
# test_dirs = tests/,test/

# Exclude patterns (optional)
# exclude_dirs = src/migrations/,src/migrations/

# Number of workers for parallel execution (optional)
# n_workers = 4

# Runner configuration (optional)
# runner = pytest

# Hash cache (optional, speeds up repeated runs)
# cache = .mutmut-cache

# Disable specific mutation types (optional)
# disable = [
#     "ArithmeticOperator",
#     "EqualityOperator"
# ]

# Custom post-mutation hook (optional)
# post_mutation_hook = echo "Mutation complete"

# Note: For XP-Gate integration, ensure:
# 1. Tests run quickly (< 120s for incremental runs)
# 2. Test files follow test_*.py naming convention
# 3. Source files are in src/ or lib/ directories
