node_modules/
*.log
.tmp-*
reinstall-runs/

# xp-gate run artefacts (report/history are regenerated on every commit)
.xp-gate/
.quality-history.jsonl

# test runner output
*.tap

# coverage/ IS tracked, on purpose. xp-gate's Gate 5 reads the report out of the
# COMMIT (`git cat-file -e :coverage/coverage-summary.json`) rather than the
# working tree, precisely so a leftover file from an unrelated run cannot
# describe this commit. Ignoring the directory therefore does not "keep the repo
# clean", it makes the floor unmeasurable and blocks every commit with
# "coverage/coverage-summary.json not found". `npm run coverage` regenerates it
# and commit-time hooks refresh it, so the tracked copy always describes the
# tree it ships with.
coverage/*
!coverage/coverage-summary.json
