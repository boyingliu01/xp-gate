{
  "name": "@boyingliu01/xp-gate",
  "version": "0.38.126",
  "description": "Deterministic quality gates for AI-generated code: 15 gates, Delphi review, sprint flow. Works with Claude Code, OpenCode, Qoder.",
  "bin": {
    "xp-gate": "bin/xp-gate.js"
  },
  "files": [
    "README.md",
    "bin/",
    "hooks/",
    "adapters/",
    "lib/",
    "gates/",
    "skills/",
    "plugins/",
    "dsh.bundle.patch.yml",
    "adapter-common.sh",
    "principles/",
    "mutation/",
    "mock-policy/",
    "build-integrity/",
    "scripts/",
    "gate-3.sh",
    "gate-4.sh",
    "gate-6-layers.sh",
    "gate-7.sh",
    "gate-8.sh",
    "gate-9.sh",
    "gate-10.sh",
    "gate-12-file-hygiene.sh",
    "gate-13-compiler-strictness.sh",
    "gate-registry.sh",
    "sprint-gate.sh"
  ],
  "dsh": {
    "bundle": {
      "patch": "./dsh.bundle.patch.yml"
    }
  },
  "exports": {
    "./tui": "./plugins/opencode/tui-plugin.ts",
    "./dsh": {
      "import": "./plugins/dsh/lib/index.js",
      "default": "./plugins/dsh/lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boyingliu01/xp-gate.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "version": "0.20.0",
    "license-check": "node scripts/check-mattpocock-license.cjs",
    "prepack": "node scripts/check-mattpocock-license.cjs && node scripts/sync-package-content.js",
    "prepare": "node scripts/generate-mirrors.cjs --quiet",
    "test": "echo \"Run tests\" && exit 0"
  },
  "keywords": [
    "ai-coding",
    "claude-code",
    "code-quality",
    "delphi",
    "developer-tools",
    "opencode",
    "qoder",
    "quality-gate",
    "sdlc",
    "static-analysis",
    "typescript",
    "ci",
    "pre-commit",
    "git-hooks",
    "lint"
  ],
  "author": "boyingliu01",
  "license": "MIT",
  "devDependencies": {
    "js-yaml": "^5.2.2",
    "zod": "^4.4.3"
  }
}
