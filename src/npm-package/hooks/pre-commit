#!/bin/bash
# Line-ending self-check (#546). Must stay on the first executable line: if this
# file is ever rewritten with CRLF, bash needs to reach this check before the
# parser chokes somewhere far away and blames an innocent line. `tr` also
# strips the \r from this very line, so the check runs even when everything
# around it is broken.
if tr -d '\r' < "$0" | sed -n '2p' | tr -d '\r' | grep -q 'Line-ending self-check'; then
  if [ "$(tr -cd '\r' < "$0" | wc -c | tr -d '[:space:]')" -gt 0 ]; then
    echo "======================================================================" >&2
    echo "FATAL: hook has CRLF line endings — bash cannot parse it (#546)." >&2
    echo "  file: $0" >&2
    echo "  fix : tr -d '\\r' < \"$0\" > \"$0.tmp\" && mv \"$0.tmp\" \"$0\" && chmod +x \"$0\"" >&2
    echo "Or re-sync the installed copy: xp-gate doctor --sync-hooks" >&2
    echo "======================================================================" >&2
    exit 1
  fi
fi
# OpenCode Quality Gates - Pre-Commit Hook - 12 numbered gates (Gate 0–11)
# 
# DESIGN PRINCIPLE: Tool unavailable = SKIP (graceful degradation), tool available + check fails = BLOCK
# Missing tools do NOT block the commit — the gate degrades to SKIP. Block fires only when
# the tool exists AND the check fails. This prevents broken toolchains from blocking work.
#
# Sourced from adapter-common.sh and language-specific adapters

# Source the common adapter functions — 3-tier resolution:
# 1. Global: ~/.config/xp-gate/adapters (for core.hooksPath global setup)
# 2. Project-local: <repo>/githooks/ (for per-project init)
# 3. Script dir: hooks directory containing this script (fallback)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ADAPTER_DIR=""
GLOBAL_ADAPTER_DIR="$HOME/.config/xp-gate/adapters"

# #505: load the resolution-order data BEFORE any tier decision runs. The file is
# generated from src/npm-package/lib/hook-module-resolution.js, which doctor.js
# also reads, so the hook and the diagnostic share one order instead of two
# hand-written copies that a parity test had to keep honest.
#
# It is looked up beside the hook (SCRIPT_DIR — always present, since this file
# IS the hook) and beside adapter-common.sh (ADAPTER_DIR — where `xp-gate init`
# and setup-global install the supporting modules). Either location works; the
# hook-dir copy is what `doctor --sync-hooks` and sync-package-content maintain.
# Note this runs BEFORE ADAPTER_DIR is resolved, which is why the script dir is
# the primary location: reading the order cannot depend on the order.
HOOK_RESOLUTION_SH="${SCRIPT_DIR}/hook-module-resolution.sh"
if [ ! -f "$HOOK_RESOLUTION_SH" ] && [ -f "$GLOBAL_ADAPTER_DIR/hook-module-resolution.sh" ]; then
  HOOK_RESOLUTION_SH="$GLOBAL_ADAPTER_DIR/hook-module-resolution.sh"
fi
if [ ! -f "$HOOK_RESOLUTION_SH" ]; then
  # Fail closed: a hook that cannot load its resolution order must not fall back
  # to an invented one — that would silently resurrect the duplication removed
  # here, and doctor would report a different surface than the hook executes.
  echo "FATAL: cannot load hook-module-resolution.sh (module resolution order is unavailable)" >&2
  echo "Fix: reinstall the hooks (xp-gate init, or xp-gate doctor --sync-hooks in the xp-gate repo)." >&2
  exit 1
fi
# shellcheck source=/dev/null
. "$HOOK_RESOLUTION_SH"

# --- Coverage threshold: ONE resolver, one number (#555) --------------------
# The threshold used to exist three times with two different values: the report
# printed a literal 80, coverage-total.sh compared against a literal 80, and the
# generic block branch echoed "below 80% threshold" — while the repo's own
# pyproject declared fail_under. CI honours the declared value, so a commit at
# 81% passed the hook (judged against 80) and failed CI (82). The report was the
# worst of the three: it quoted a threshold as though it were the enforced one,
# and a plausible wrong number is harder to notice than a visible gap.
#
# Resolve from the repo's own declaration, in the order the tools themselves
# use: pyproject [tool.coverage.report] fail_under, then .coveragerc. A repo
# declaring neither keeps the historical 80.
_resolve_coverage_threshold() {
  _rct_value=""
  _rct_src="default"
  if [ -f pyproject.toml ]; then
    _rct_value=$(python -c "import tomllib;print(tomllib.load(open('pyproject.toml','rb'))['tool']['coverage']['report']['fail_under'])" 2>/dev/null || true)
    [ -n "$_rct_value" ] && _rct_src="pyproject.toml [tool.coverage.report] fail_under"
    if [ -z "$_rct_value" ]; then
      _rct_value=$(grep -oE '^[[:space:]]*fail_under[[:space:]]*=[[:space:]]*[0-9]+' pyproject.toml 2>/dev/null | grep -oE '[0-9]+' | head -1 || true)
      [ -n "$_rct_value" ] && _rct_src="pyproject.toml fail_under (text scan)"
    fi
  fi
  if [ -z "$_rct_value" ] && [ -f .coveragerc ]; then
    _rct_value=$(grep -oE '^[[:space:]]*fail_under[[:space:]]*=[[:space:]]*[0-9]+' .coveragerc 2>/dev/null | grep -oE '[0-9]+' | head -1 || true)
    [ -n "$_rct_value" ] && _rct_src=".coveragerc fail_under"
  fi
  case "$_rct_value" in
    ''|*[!0-9]*) _rct_value="80"; _rct_src="default (no fail_under declared)" ;;
  esac
  COVERAGE_THRESHOLD_SOURCE="$_rct_src"
  printf '%s' "$_rct_value"
}
COVERAGE_THRESHOLD="$(_resolve_coverage_threshold)"

# Look up one tier's directory variable by name without eval-ing arbitrary input:
# the base names are a closed set baked into the generated file.
_hook_tier_base() {
  case "$1" in
    ADAPTER_DIR)      printf '%s' "$ADAPTER_DIR" ;;
    GLOBAL_ADAPTER_DIR) printf '%s' "$GLOBAL_ADAPTER_DIR" ;;
    PROJECT_GITHOOKS) printf '%s' "$PROJECT_GITHOOKS" ;;
    SCRIPT_DIR)       printf '%s' "$SCRIPT_DIR" ;;
    *)                printf '%s' "" ;;
  esac
}

# Walk a "tier_id|base|suffix" table in order and print the first existing match.
# Usage: _hook_resolve <module_filename> <tiers_array_name>
_hook_resolve() {
  local module_name="$1"
  local tiers_var="$2"
  local entry base suffix base_dir candidate
  eval "set -- \"\${${tiers_var}[@]}\""
  for entry in "$@"; do
    entry="${entry#*|}"
    base="${entry%%|*}"
    suffix="${entry#*|}"
    base_dir="$(_hook_tier_base "$base")"
    [ -n "$base_dir" ] || continue
    candidate="$base_dir/${suffix/\{name\}/$module_name}"
    if [ -f "$candidate" ]; then
      printf '%s' "$candidate"
      return 0
    fi
  done
  return 1
}

# Walk a gate tier table and print the first DIRECTORY that contains the probe.
# The adapter table yields a file; this one yields the directory the gate suite
# lives in (GATE_DIR), which is why it probes rather than substitutes.
# Usage: _hook_resolve_dir <probe_filename> <tiers_array_name>
_hook_resolve_dir() {
  local probe="$1"
  local tiers_var="$2"
  local entry base suffix base_dir
  eval "set -- \"\${${tiers_var}[@]}\""
  for entry in "$@"; do
    entry="${entry#*|}"
    base="${entry%%|*}"
    suffix="${entry#*|}"
    base_dir="$(_hook_tier_base "$base")"
    [ -n "$base_dir" ] || continue
    if [ -f "$base_dir${suffix}/$probe" ]; then
      printf '%s' "$base_dir${suffix}"
      return 0
    fi
  done
  return 1
}

# BEGIN GIT CONTEXT FALLBACK
if ! declare -F run_without_git_context >/dev/null 2>&1; then
  run_without_git_context() (
    unset GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_CONFIG GIT_CONFIG_PARAMETERS
    unset GIT_CONFIG_COUNT GIT_OBJECT_DIRECTORY GIT_DIR GIT_WORK_TREE
    unset GIT_IMPLICIT_WORK_TREE GIT_GRAFT_FILE GIT_INDEX_FILE
    unset GIT_NO_REPLACE_OBJECTS GIT_REPLACE_REF_BASE GIT_PREFIX
    unset GIT_SHALLOW_FILE GIT_COMMON_DIR
    "$@"
  )
fi
# END GIT CONTEXT FALLBACK

PROJECT_GITHOOKS="$(run_without_git_context git rev-parse --show-toplevel 2>/dev/null)/githooks"
GATES_DIR="$SCRIPT_DIR/gates"

if [ -f "$GLOBAL_ADAPTER_DIR/adapter-common.sh" ]; then
  ADAPTER_DIR="$GLOBAL_ADAPTER_DIR"
elif [ -f "$PROJECT_GITHOOKS/adapter-common.sh" ]; then
  ADAPTER_DIR="$PROJECT_GITHOOKS"
else
  ADAPTER_DIR="$SCRIPT_DIR"
fi
source "$ADAPTER_DIR/adapter-common.sh" 2>/dev/null || {
  echo "Error: Cannot source adapter-common.sh from $ADAPTER_DIR"
  echo "Run: xp-gate init (per-project) or xp-gate setup-global (all projects)"
  exit 1
}

# Resolve adapter file path — handles both layouts:
#   Global:      ~/.config/xp-gate/adapters/typescript.sh      (flat)
#   Project:     <repo>/githooks/adapters/typescript.sh          (nested)
#   Script dir:  <hook-dir>/adapters/typescript.sh               (nested)
# ADAPTER_DIR points to the base directory that contains either
# adapter-common.sh directly (global) or adapter-common.sh in a flat layout.
# Gate scripts live alongside adapter-common.sh.
#
# #505: the ORDER is not written here. HOOK_ADAPTER_TIERS is generated from
# src/npm-package/lib/hook-module-resolution.js, which doctor.js reads directly,
# so the hook and the diagnostic cannot disagree about which file wins.
resolve_adapter_path() {
  # ADAPTER templates carry the extension ("{name}.sh"), so pass the bare language
  # name here. GATE templates are "{name}", so their call passes the full filename.
  _hook_resolve "${1}" HOOK_ADAPTER_TIERS
}

# Gate scripts directory — falls back to project githooks if ADAPTER_DIR doesn't have them.
# #505: the probe file and the tier order come from the generated data file, so
# this cascade cannot drift from what doctor.js reports.
GATE_DIR="$(_hook_resolve_dir "$HOOK_GATE_PROBE" HOOK_GATE_TIERS)" || GATE_DIR=""
# Deliberate last resort: when no tier carries the gate suite, point at
# ADAPTER_DIR anyway rather than leaving GATE_DIR empty. The gate-N.sh sources
# further down check for the file before sourcing, so an absent suite still
# degrades to a reported skip instead of a path built from an empty string.
if [ -z "$GATE_DIR" ]; then
  GATE_DIR="$ADAPTER_DIR"
fi

# Trap: ensure quality report generated on ANY exit (pass or fail).
# Using a guard prevents recursion when 'exit' is called from inside the trap.
# IMPORTANT: Captures exit status FIRST so generate_quality_report cannot override it.
_QUALITY_REPORT_DONE=0
_quality_report_on_exit() {
  local _saved_exit=$?
  if [ "$_QUALITY_REPORT_DONE" = "1" ]; then
    exit $_saved_exit
    return
  fi
  _QUALITY_REPORT_DONE=1
  command -v generate_quality_report >/dev/null 2>&1 && generate_quality_report 2>/dev/null || true
  exit $_saved_exit
}
trap '_quality_report_on_exit' EXIT

PROJECT_ROOT="$(run_without_git_context git rev-parse --show-toplevel 2>/dev/null || echo "$(cd "$SCRIPT_DIR/../.." 2>/dev/null || echo "$SCRIPT_DIR/..")" )"
if [[ -d "$PROJECT_ROOT/node_modules/.bin" ]]; then
  export PATH="$PROJECT_ROOT/node_modules/.bin:$PATH"
fi

# Ensure pipe failures propagate exit codes through | head/tail/grep
set -o pipefail

# ============================================================================
# Helper Functions
# ============================================================================

# Run a TypeScript entrypoint under tsx without routing arguments through the
# npx shim: Windows cmd.exe caps command lines at 8191 chars and long staged
# file lists (Boy Scout, build integrity) overflow it, turning a healthy run
# into a false BLOCK. Prefer the repo-local tsx CLI driven by node directly;
# keep npx as fallback for consumer repos relying on a global install.
# RUN_TSX_TIMEOUT (e.g. "120s") wraps the invocation in `timeout`.
if ! declare -F run_tsx >/dev/null 2>&1; then
  run_tsx() {
    local _root="${PROJECT_ROOT:-$(pwd)}" _timeout=()
    if [ -n "${RUN_TSX_TIMEOUT:-}" ]; then
      _timeout=(timeout "$RUN_TSX_TIMEOUT")
    fi
    if [ -f "$_root/node_modules/tsx/dist/cli.mjs" ] && command -v node >/dev/null 2>&1; then
      "${_timeout[@]}" node "$_root/node_modules/tsx/dist/cli.mjs" "$@"
    else
      "${_timeout[@]}" npx tsx "$@"
    fi
  }
fi

# Gate 5's vitest exit-code judgement (is_runner_infrastructure_error,
# is_partial_threshold_only_exit, handle_test_failure) is sourced from
# lib/test-failure.sh below, next to the other hook libraries.

# Parse LCOV file and return coverage percentage
# Usage: parse_lcov_coverage <lcov_file>
# Returns: coverage percentage (e.g., "85.5")
parse_lcov_coverage() {
  local lcov_file="$1"
  local total_lines=0
  local covered_lines=0
  
  if [ ! -f "$lcov_file" ]; then
    echo "0"
    return
  fi
  
  # Extract LF (Lines Found) and LH (Lines Hit) from lcov.info
  while IFS= read -r line; do
    case "$line" in
      LF:*)
        total_lines=$(echo "$line" | sed 's/LF://')
        ;;
      LH:*)
        covered_lines=$(echo "$line" | sed 's/LH://')
        ;;
    esac
  done < "$lcov_file"
  
  if [ "$total_lines" -gt 0 ]; then
    # Calculate percentage using awk for floating point
    awk "BEGIN {printf \"%.1f\", ($covered_lines / $total_lines) * 100}"
  else
    echo "0"
  fi
}

# Run command in subdirectory if PROJECT_SUBDIR is set
# Usage: run_in_subdir <command>
run_in_subdir() {
  local cmd="$1"
  
  if [ -n "$PROJECT_SUBDIR" ] && [ "$PROJECT_SUBDIR" != "." ]; then
    # Run command in subdirectory, then return to original directory
    # #392-#10: guard cd/pushd so a missing directory cannot run the gate in
    # the wrong cwd.
    if pushd "$PROJECT_SUBDIR" > /dev/null 2>&1; then
      eval "$cmd"
      local exit_code=$?
      popd > /dev/null 2>&1
      return $exit_code
    fi
    return 1
  else
    # Run in current directory
    eval "$cmd"
    return $?
  fi
}

# Check if file exists in subdirectory
# Usage: file_exists_in_subdir <filename>
file_exists_in_subdir() {
  local filename="$1"
  
  if [ -n "$PROJECT_SUBDIR" ] && [ "$PROJECT_SUBDIR" != "." ]; then
    [ -f "$PROJECT_SUBDIR/$filename" ]
  else
    [ -f "$filename" ]
  fi
}

# ============================================================================
# Audit/Timing helpers — must be defined BEFORE first gate call (line ~197)
# Bash executes top-to-bottom; gate_start_ms + record_gate_audit are called
# in every gate, so their definitions lead the first call.
# ============================================================================
AUDIT_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT_FOR_AUDIT="$(git rev-parse --show-toplevel 2>/dev/null || echo "$AUDIT_SCRIPT_DIR/../..")"

# Issue #535: a failed `source` used to print one stderr line and keep going,
# so a missing lib silently removed gate logic from the run while every gate
# still reported PASS. Fail closed instead: abort with FATAL when the file is
# absent or its body exits non-zero while being sourced. `exit` inside a
# sourced file exits the SOURCING shell, so an `if ! source` wrapper cannot
# catch it — trap EXIT for the duration of the source instead.
source_gate_lib() {
  local lib_file="$1"
  if [ ! -f "$lib_file" ]; then
    echo "FATAL: cannot load $lib_file (missing)" >&2
    exit 1
  fi
  # Marker the EXIT trap compares against: only a source that never reached
  # its end counts as a load failure. A lib calling `exit` at top level would
  # otherwise be misread as a crash after it already did its job.
  SOURCE_GATE_LIB_COMPLETED=""
  local prev_trap=""
  prev_trap="$(trap -p EXIT || true)"
  # shellcheck disable=SC2064  # expand lib_file NOW: it is the failure target
  trap "[ -n \"\$SOURCE_GATE_LIB_COMPLETED\" ] || { echo 'FATAL: cannot load $lib_file (source failed)' >&2; exit 1; }" EXIT
  # shellcheck disable=SC1090  # sourcing the resolved lib is the contract here
  source "$lib_file"
  SOURCE_GATE_LIB_COMPLETED=1
  eval "$prev_trap"
}

# Issue #370: source cross-platform now_ms() helper (node-preferred, regex-validated)
source_gate_lib "${AUDIT_SCRIPT_DIR}/lib/now-ms.sh"
# REQ-B: duration bookkeeping sanitizer used by record_gate_audit below.
source_gate_lib "${AUDIT_SCRIPT_DIR}/lib/audit-sanitize.sh"
# REQ-F2 (sprint-20261018-quality): commit-level docs-only detection used to
# short-circuit the heavy, code-blind gates below. Distinct from the
# PROJECT-level documentation_project detection further down.
source_gate_lib "${AUDIT_SCRIPT_DIR}/lib/docs-only.sh"

# Issue #473 (+ #454): Gate 5's vitest exit-code judgement, sourced as a library
# so the fail-closed contract is unit-testable without executing this hook.
source_gate_lib "${AUDIT_SCRIPT_DIR}/lib/test-failure.sh"

# Issue #477: Gate 2's jscpd config probe and outcome classification, same reason.
source_gate_lib "${AUDIT_SCRIPT_DIR}/lib/jscpd-run.sh"

# Issue #476: Gate 11's sprint-gate.sh resolution chain and decision translation.
source_gate_lib "${AUDIT_SCRIPT_DIR}/lib/sprint-gate-report.sh"

# Issue #523: Gate 5's Python coverage parsing and threshold verdict. The old
# `grep -o '[0-9]*%'` never matched --format=total's bare number, so the 80%
# branch never ran; sourced as a library so the fail-closed contract is
# unit-testable without executing this hook.
source_gate_lib "${AUDIT_SCRIPT_DIR}/lib/coverage-total.sh"

# Issue #399: Python smart test selection — strategy decision + related-test
# lookup, kept in a library so the truth table and the path conventions are
