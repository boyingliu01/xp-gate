skill-cert/*.egg-info/
results/

# Worktrees
.worktrees/

# .omo runtime data (keep templates/config, exclude run-continuation session files)
.omo/run-continuation/

# OpenCode runtime (project-level overrides managed globally)
.opencode/
.opencode.delete/
.worktrees/

# Plugin build artifacts (skills copied during build, not committed)
plugins/claude-code/skills/
plugins/opencode/skills/
plugins/**/*.lock
plugins/**/*.js.map
plugins/opencode/dist/
plugins/opencode/node_modules/
plugins/opencode/package-lock.json

# Mirror build artifacts (regenerated by sync-package-content.js, must not be committed)
src/npm-package/plugins/**/package-lock.json
src/npm-package/plugins/**/*.lock
src/npm-package/plugins/**/*.js.map
src/npm-package/plugins/opencode/dist/
src/npm-package/plugins/opencode/node_modules/

# Gate result artifacts (per-run, transient)
.ui-gate-result.json
.code-walkthrough-result.json
architecture-report.sarif.json
undefined/

# Better Loop report artifacts (auto-generated, local-only)
.qoder/better-loop/
