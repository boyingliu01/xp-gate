# Temporary
*.tmp
*.temp
.cache/.worktrees/
.sisyphus/
.sprint-state/

# XP-Gate quality status (per-branch, local-only — not shared across devs)
.xp-gate/quality-status/
.xp-gate/reports/
.xp-gate/lint-baseline.json
.xpgate-review/

# Per-commit/branch report artifacts (local-only transient output)
.test-alignment-report.json
.warnings-baseline.json
.audit-log.jsonl

# Mutation testing
.mutation-baseline.json
.stryker-report.json
.stryker-tmp/

# Skill-cert
skill-cert/venv/
skill-cert/.pytest_cache/
skill-cert/.coverage
skill-cert/__pycache__/
