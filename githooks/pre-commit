#!/bin/bash
_LE_CR=$(tr -cd '\r' < "$0" | wc -c | tr -d '[:space:]'); test "${_LE_CR:-0}" -eq 0 || { printf '%s\n' "======================================================================" "FATAL: hook has CRLF line endings -- bash cannot parse it (#546)." "  file: $0" "  fix : tr -d '\\r' < \"$0\" > \"$0.tmp\" && mv \"$0.tmp\" \"$0\" && chmod +x \"$0\"" "Or re-sync the installed copy: xp-gate doctor --sync-hooks" "======================================================================" >&2; exit 1; }
#
# The line above is the #546 line-ending self-check. It MUST stay on the first
# executable line, as a SINGLE physical line, using no construct whose keyword
# needs a line boundary. All three are load-bearing:
#
#  * A CRLF rewrite puts \r at the end of EVERY line. Any construct whose
#    keywords must match across lines -- if/then/fi, case/esac, for/do/done --
#    then fails to PARSE and none of it runs. The original #546 implementation
#    was a nested if/fi spanning 11 lines: it could not survive the very
#    condition it detects. On a CRLF copy bash reported
#        line 76: syntax error near unexpected token `$'{\r''
#    blaming an innocent function far below -- which is exactly the failure #546
#    set out to prevent. It looked correct locally only because that bash build
#    deferred the error past the first command.
#  * Even on one line, `if ... then ... fi` ends in `fi\r`, and `then\r` / `fi\r`
#    are ordinary words to the tokenizer. So the check uses only
#    `test ... || { ...; exit 1; }`: the `{` already follows `; `, so a trailing
#    \r on the line cannot change how it tokenizes.
#  * The CR count is byte-wise (`tr -cd`). `grep -c $'\r'` reports 0 matches
#    through the Git-Bash/MSYS layer even on files that carry CR bytes, which is
#    what made earlier attempts at this fixture look green while CI stayed red.
#
# Verified: an LF copy runs through (0 CR bytes); a CRLF copy prints the FATAL
# diagnosis and exits 1 with no syntax error.
# OpenCode Quality Gates - Pre-Commit Hook - 12 numbered gates (Gate 0–11)
# 
# DESIGN PRINCIPLE: Tool unavailable = SKIP (graceful degradation), tool available + check fails = BLOCK
# Missing tools do NOT block the commit — the gate degrades to SKIP. Block fires only when
# the tool exists AND the check fails. This prevents broken toolchains from blocking work.
#
# Sourced from adapter-common.sh and language-specific adapters

# Source the common adapter functions — 3-tier resolution:
# 1. Global: ~/.config/xp-gate/adapters (for core.hooksPath global setup)
# 2. Project-local: <repo>/githooks/ (for per-project init)
# 3. Script dir: hooks directory containing this script (fallback)
# ── #640: wall-clock start, written into the per-run report ──────────────────
# The gate journal records every gate's verdict but no timing, so a slow commit
# could not be attributed: the #640 measurement found ~11s per commit outside any
# gate and had no instrument to say where it went. One timestamp at entry and one
# subtraction at report-write time turns "it feels slow" into a number.
#
# #798: BOTH ends of this duration come from ONE clock — `now_ms`, the shared
# helper in lib/now-ms.sh (node Date.now(), regex-validated, `date +%s` fallback).
#
# The #640 version read /proc/uptime at both ends and parsed the fraction with
# `cut -c1-3`. That parser is LOSSY when the fraction has fewer than three
# digits:
#
#     /proc/uptime -> "331154.04"     (two fraction digits)
#     parsed       -> 33115404        (expected 331154040)  <-- 10x too small
#
# Because both ends lost the same digit the error partially cancelled on long
# runs, which is exactly why it was invisible: #798 comment 2 recorded a report
# of 21,754 ms against a measured 199,000 ms. Short runs meanwhile lost all
# sub-10s resolution and could even subtract negative. `now_ms` has no fraction
# to truncate, so there is no digit to lose.
#
# Latching the start here means now-ms.sh must already be sourced, so SCRIPT_DIR
# is resolved first. The regular source_gate_lib() chain cannot be used yet: it
# resolves the tier table, which is loaded further down.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_XP_HOOK_START_MS=""
for _xp_now_ms_candidate in \
  "${SCRIPT_DIR}/lib/now-ms.sh" \
  "${SCRIPT_DIR}/hooks/lib/now-ms.sh" \
  "../githooks/lib/now-ms.sh"; do
  if [ -f "$_xp_now_ms_candidate" ]; then
    # shellcheck disable=SC1090  # sourcing the resolved lib is the contract here
    source "$_xp_now_ms_candidate"
    break
  fi
done
# Without now_ms the duration is unmeasurable. Leave the start empty so the
# report omits the field; never substitute a different clock to "have a number".
if command -v now_ms >/dev/null 2>&1; then
  _XP_HOOK_START_MS=$(now_ms)
fi
# Exported so subshells and child hooks can see the same hook-entry instant.
export _XP_HOOK_START_MS
unset _xp_now_ms_candidate
# #609: 1-based attempt index for this hook run. One hook invocation is one attempt,
# so every gate recorded during it shares the same index. Left empty by default so a
# caller that genuinely does not know the index omits the field instead of guessing.
_XP_GATE_ATTEMPT=""
# #798: gate-name -> measured duration in ms, filled by record_gate_audit and
# emitted once into the per-run report by gate_timings_json. Declared here so
# every writer sees the same table; bash 4+ is required for associative arrays
# and the hook already relies on that elsewhere (`${var//pat/rep}` with classes).
declare -A _XP_GATE_DURATIONS=()
ADAPTER_DIR=""
GLOBAL_ADAPTER_DIR="$HOME/.config/xp-gate/adapters"

# #505: load the resolution-order data BEFORE any tier decision runs. The file is
# generated from src/npm-package/lib/hook-module-resolution.js, which doctor.js
# also reads, so the hook and the diagnostic share one order instead of two
# hand-written copies that a parity test had to keep honest.
#
# It is looked up beside the hook (SCRIPT_DIR — always present, since this file
# IS the hook) and beside adapter-common.sh (ADAPTER_DIR — where `xp-gate init`
# and setup-global install the supporting modules). Either location works; the
# hook-dir copy is what `doctor --sync-hooks` and sync-package-content maintain.
# Note this runs BEFORE ADAPTER_DIR is resolved, which is why the script dir is
# the primary location: reading the order cannot depend on the order.
HOOK_RESOLUTION_SH="${SCRIPT_DIR}/hook-module-resolution.sh"
if [ ! -f "$HOOK_RESOLUTION_SH" ] && [ -f "$GLOBAL_ADAPTER_DIR/hook-module-resolution.sh" ]; then
  HOOK_RESOLUTION_SH="$GLOBAL_ADAPTER_DIR/hook-module-resolution.sh"
fi
if [ ! -f "$HOOK_RESOLUTION_SH" ]; then
  # Fail closed: a hook that cannot load its resolution order must not fall back
  # to an invented one — that would silently resurrect the duplication removed
  # here, and doctor would report a different surface than the hook executes.
  echo "FATAL: cannot load hook-module-resolution.sh (module resolution order is unavailable)" >&2
  echo "Fix: reinstall the hooks (xp-gate init, or xp-gate doctor --sync-hooks in the xp-gate repo)." >&2
  exit 1
fi
# shellcheck source=/dev/null
. "$HOOK_RESOLUTION_SH"

# Same contract check pre-push performs, and for the same reason: a file that
# sources cleanly but predates schema 2 provides NO _hook_tier_dir, so every
# tier lookup below would return empty and the hook would degrade silently --
# resolving adapters only from the script dir, which is #495 in miniature. This
# hook fails closed rather than degrading, so the check must be fatal here.
if ! declare -F _hook_tier_dir >/dev/null 2>&1; then
  echo "FATAL: hook-module-resolution.sh is STALE (schema ${HOOK_RESOLUTION_SCHEMA:-1}, need 2)." >&2
  echo "Fix: node scripts/generate-hook-resolution.cjs, or xp-gate doctor --sync-hooks." >&2
  exit 1
fi
if [ -n "${_HOOK_RESOLVE_BROKEN:-}" ]; then
  echo "FATAL: hook-module-resolution.sh failed its contract selfcheck: ${_HOOK_RESOLVE_BROKEN}" >&2
  echo "Fix: node scripts/generate-hook-resolution.cjs, or xp-gate doctor --sync-hooks." >&2
  exit 1
fi

# --- Coverage threshold: ONE resolver, one number (#555) --------------------
# The threshold used to exist three times with two different values: the report
# printed a literal 80, coverage-total.sh compared against a literal 80, and the
# generic block branch echoed "below 80% threshold" — while the repo's own
# pyproject declared fail_under. CI honours the declared value, so a commit at
# 81% passed the hook (judged against 80) and failed CI (82). The report was the
# worst of the three: it quoted a threshold as though it were the enforced one,
# and a plausible wrong number is harder to notice than a visible gap.
#
# Resolve from the repo's own declaration, in the order the tools themselves
# use: pyproject [tool.coverage.report] fail_under, then .coveragerc, then the
# JS/TS runner's own threshold block. A repo declaring none keeps the historical 80.
#
# #605: the JS/TS branch below enforces THIS number, but the resolver only ever
# read Python declarations -- so a vitest project declaring `thresholds.lines: 60`
# was silently judged against 80. The result was the worst possible split:
# `npx vitest run` goes green, the commit is then rejected, and the two numbers
# are read from different files with nothing pointing at the disagreement.
# Same defect shape as #554/#609: a declaration exists, an enforcement exists,
# and nothing connected them.
_resolve_coverage_threshold() {
  _rct_value=""
  _rct_src="default"
  if [ -f pyproject.toml ]; then
    _rct_value=$(python -c "import tomllib;print(tomllib.load(open('pyproject.toml','rb'))['tool']['coverage']['report']['fail_under'])" 2>/dev/null || true)
    [ -n "$_rct_value" ] && _rct_src="pyproject.toml [tool.coverage.report] fail_under"
    if [ -z "$_rct_value" ]; then
      _rct_value=$(grep -oE '^[[:space:]]*fail_under[[:space:]]*=[[:space:]]*[0-9]+' pyproject.toml 2>/dev/null | grep -oE '[0-9]+' | head -1 || true)
      [ -n "$_rct_value" ] && _rct_src="pyproject.toml fail_under (text scan)"
    fi
  fi
  if [ -z "$_rct_value" ] && [ -f .coveragerc ]; then
    _rct_value=$(grep -oE '^[[:space:]]*fail_under[[:space:]]*=[[:space:]]*[0-9]+' .coveragerc 2>/dev/null | grep -oE '[0-9]+' | head -1 || true)
    [ -n "$_rct_value" ] && _rct_src=".coveragerc fail_under"
  fi
  # #605: JS/TS. Read the runner's own threshold rather than assuming 80, so the
  # hook enforces the number the project actually declares. `lines` specifically:
  # it is the metric the JS branch below compares, and it is the one vitest docs
  # lead with. Only the FLAT shape is read -- the nested `thresholds: { global }`
  # form is vitest 2.x and was proven silently dropped by the 1.6.x config parser
  # (#561), so honouring it here would enforce a number that never takes effect.
  if [ -z "$_rct_value" ]; then
    for _rct_cfg in vitest.config.ts vitest.config.js vitest.config.mts; do
      [ -f "$_rct_cfg" ] || continue
      _rct_value=$(sed -n '/thresholds[[:space:]]*:[[:space:]]*{/,/}/p' "$_rct_cfg" 2>/dev/null \
        | grep -oE 'lines[[:space:]]*:[[:space:]]*[0-9]+' | grep -oE '[0-9]+' | head -1 || true)
      if [ -n "$_rct_value" ]; then
        _rct_src="$_rct_cfg coverage.thresholds.lines"
        break
      fi
    done
  fi
  case "$_rct_value" in
    ''|*[!0-9]*) _rct_value="80"; _rct_src="default (no coverage threshold declared)" ;;
  esac
  COVERAGE_THRESHOLD_SOURCE="$_rct_src"
  printf '%s' "$_rct_value"
}
# NOT `COVERAGE_THRESHOLD="$(_resolve_coverage_threshold)"`: command substitution
# runs in a subshell, so `COVERAGE_THRESHOLD_SOURCE` set inside the function was
# discarded and the audit record's `threshold_source` field was empty on every
# single commit. A field that is always blank is worse than a missing one -- it
# looks populated and says nothing. Call the function in this shell instead.
_resolve_coverage_threshold >/dev/null
COVERAGE_THRESHOLD="$_rct_value"

# Tier lookups delegate to the generated projection (schema 2).
#
# WHAT THIS REPLACED
# ------------------
# Three local functions -- `_hook_tier_base`, `_hook_resolve`, `_hook_resolve_dir`
# -- each with its own `eval "set -- \"${${tiers_var}[@]}\""` walk and its own
# copy of the same indirection. pre-push carried a FOURTH, hand-written, with the
# tier order inverted (global first). Four traversals of the same table is how a
# table ends up describing one order and the code running another.
#
# `_hook_tier_dir` now comes from hook-module-resolution.sh and answers only
# "what directory is tier X rooted at". The two functions below keep their
# distinct jobs -- one yields a FILE, one yields a DIRECTORY -- but neither
# re-implements the walk or the order.
# NOTE on the split: only tiers that appear in HOOK_ADAPTER_DIR_TIERS can go
# through the projection. ADAPTER_DIR is declared in HOOK_ADAPTER_TIERS (a
# different table with different entries) and SCRIPT_DIR is the hook's own
# location, which needs no resolution at all -- both read their variable
# directly, exactly as before. Routing them through the projection would have
# returned empty for ADAPTER_DIR and silently disabled the flat adapter tier.
_hook_tier_base() {
  case "$1" in
    ADAPTER_DIR)        printf '%s' "$ADAPTER_DIR" ;;
    SCRIPT_DIR)         printf '%s' "$SCRIPT_DIR" ;;
    GLOBAL_ADAPTER_DIR) _hook_tier_dir global GLOBAL_ADAPTER_DIR ;;
    PROJECT_GITHOOKS)   _hook_tier_dir project PROJECT_GITHOOKS ;;
    *)                  printf '%s' "" ;;
  esac
}

# Walk a "tier_id|base|suffix" table in order and print the first existing match.
# Usage: _hook_resolve <module_filename> <tiers_array_name>
_hook_resolve() {
  local module_name="$1"
  local tiers_var="$2"
  local entry base suffix base_dir candidate
  eval "set -- \"\${${tiers_var}[@]}\""
  for entry in "$@"; do
    entry="${entry#*|}"
    base="${entry%%|*}"
    suffix="${entry#*|}"
    base_dir="$(_hook_tier_base "$base")"
    [ -n "$base_dir" ] || continue
    candidate="$base_dir/${suffix/\{name\}/$module_name}"
    if [ -f "$candidate" ]; then
      printf '%s' "$candidate"
      return 0
    fi
  done
  return 1
}

# Walk a gate tier table and print the first DIRECTORY that contains the probe.
# The adapter table yields a file; this one yields the directory the gate suite
# lives in (GATE_DIR), which is why it probes rather than substitutes.
# Usage: _hook_resolve_dir <probe_filename> <tiers_array_name>
_hook_resolve_dir() {
  local probe="$1"
  local tiers_var="$2"
  local entry base suffix base_dir
  eval "set -- \"\${${tiers_var}[@]}\""
  for entry in "$@"; do
    entry="${entry#*|}"
    base="${entry%%|*}"
    suffix="${entry#*|}"
    base_dir="$(_hook_tier_base "$base")"
    [ -n "$base_dir" ] || continue
    if [ -f "$base_dir${suffix}/$probe" ]; then
      printf '%s' "$base_dir${suffix}"
      return 0
    fi
  done
  return 1
}

# BEGIN GIT CONTEXT FALLBACK
if ! declare -F run_without_git_context >/dev/null 2>&1; then
  run_without_git_context() (
    unset GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_CONFIG GIT_CONFIG_PARAMETERS
    unset GIT_CONFIG_COUNT GIT_OBJECT_DIRECTORY GIT_DIR GIT_WORK_TREE
