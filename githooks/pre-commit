PROJECT_GITHOOKS="$(run_without_git_context git rev-parse --show-toplevel 2>/dev/null)/githooks"
GATES_DIR="$SCRIPT_DIR/gates"

# ADAPTER_DIR decides which tree every later lookup searches, so its ORDER comes
# from HOOK_ADAPTER_DIR_TIERS (generated from lib/hook-module-resolution.js) and
# never from a cascade typed here. This block used to be a hand-written
# `if global ... elif project ...`, which meant the generated table was loaded and
# then ignored: flipping the spec to project-first changed nothing at runtime
# while the data file and doctor both already reported the new order.
#
# _hook_resolve, not _hook_resolve_dir: the ADAPTER table's third field is the
# probe FILENAME ('adapter-common.sh'), so resolving it as a module template is
# what yields "<tier_dir>/adapter-common.sh". _hook_resolve_dir treats that field
# as a directory suffix and would build "<tier_dir>adapter-common.sh/...".
ADAPTER_DIR="$(_hook_resolve 'adapter-common' HOOK_ADAPTER_DIR_TIERS)" || ADAPTER_DIR="$SCRIPT_DIR"
ADAPTER_DIR="${ADAPTER_DIR%/adapter-common.sh}"
source "$ADAPTER_DIR/adapter-common.sh" 2>/dev/null || {
  echo "Error: Cannot source adapter-common.sh from $ADAPTER_DIR"
  echo "Run: xp-gate init (per-project) or xp-gate setup-global (all projects)"
  exit 1
}

# Resolve adapter file path — handles both layouts:
#   Global:      ~/.config/xp-gate/adapters/typescript.sh      (flat)
#   Project:     <repo>/githooks/adapters/typescript.sh          (nested)
#   Script dir:  <hook-dir>/adapters/typescript.sh               (nested)
# ADAPTER_DIR points to the base directory that contains either
# adapter-common.sh directly (global) or adapter-common.sh in a flat layout.
# Gate scripts live alongside adapter-common.sh.
#
# #505: the ORDER is not written here. HOOK_ADAPTER_TIERS is generated from
# src/npm-package/lib/hook-module-resolution.js, which doctor.js reads directly,
# so the hook and the diagnostic cannot disagree about which file wins.
resolve_adapter_path() {
  # ADAPTER templates carry the extension ("{name}.sh"), so pass the bare language
  # name here. GATE templates are "{name}", so their call passes the full filename.
  _hook_resolve "${1}" HOOK_ADAPTER_TIERS
}

# #798 / #794: does the CURRENTLY SOURCED adapter's run_coverage() already
# execute and validate the test suite?
#
# Usage: adapter_declares_coverage_runs_tests [<adapter-scope-command>]
#
# Returns 0 (true) only when the adapter explicitly declares
# `coverage_runs_tests()`. Everything else — no function, no adapter, an error
# while probing — returns 1, which makes the caller run the tests normally.
#
# The optional argument names a command that, when invoked in a subshell, provides
# the adapter's environment (used by the tests to exercise the contract without
# sourcing a real adapter). The default scope is the current shell, which is where
# the hook has already sourced $ADAPTER_FILE.
#
# The asymmetry is intentional and is the whole design: a wrong "yes" silently
# removes test verification from every commit, while a wrong "no" merely costs
# the time this issue exists to save. When the two failure modes are that
# different in severity, the default must favour the cheap one.
#
# This replaces `[ "$CURRENT_LANG" = "python" ]` in the test phase, which could
# only ever cover a language someone remembered to name (#794 records that
# pattern already being applied twice, once per language).
adapter_declares_coverage_runs_tests() {
  local scope="${1:-}"
  if [ -n "$scope" ]; then
    # Probe inside a subshell so the scope command's state (and any function it
    # defines) cannot leak into the gate.
    (
      # shellcheck disable=SC2086  # $scope is a single command name, deliberately unquoted for eval-free invocation
      $scope >/dev/null 2>&1 || exit 1
      command -v coverage_runs_tests >/dev/null 2>&1 || exit 1
      coverage_runs_tests >/dev/null 2>&1
    )
    return $?
  fi
  # A function that is not defined means "no declaration".
  command -v coverage_runs_tests >/dev/null 2>&1 || return 1
  # Run it in a subshell so a declaration that misbehaves cannot leak state
  # (cd, variable mutation) into the gate.
  ( coverage_runs_tests ) >/dev/null 2>&1
}

# Gate scripts directory — falls back to project githooks if ADAPTER_DIR doesn't have them.
# #505: the probe file and the tier order come from the generated data file, so
# this cascade cannot drift from what doctor.js reports.
GATE_DIR="$(_hook_resolve_dir "$HOOK_GATE_PROBE" HOOK_GATE_TIERS)" || GATE_DIR=""
# Deliberate last resort: when no tier carries the gate suite, point at
# ADAPTER_DIR anyway rather than leaving GATE_DIR empty. The gate-N.sh sources
# further down check for the file before sourcing, so an absent suite still
# degrades to a reported skip instead of a path built from an empty string.
if [ -z "$GATE_DIR" ]; then
  GATE_DIR="$ADAPTER_DIR"
fi

# Gate registry (#717 walkthrough): binds each gate's NAME to the file that
# runs it, so a gate can be referred to by what it does rather than by a
# positional number. Optional by design — a consumer repo installed from an
# older package will not have it, and the hooks must keep working there.
_GATE_REGISTRY="$GATE_DIR/gate-registry.sh"
[ -f "$_GATE_REGISTRY" ] || _GATE_REGISTRY="$(git rev-parse --show-toplevel 2>/dev/null)/githooks/gate-registry.sh"
if [ -f "$_GATE_REGISTRY" ]; then
  # shellcheck source=/dev/null
  . "$_GATE_REGISTRY"
fi

# Trap: ensure quality report generated on ANY exit (pass or fail).
# Using a guard prevents recursion when 'exit' is called from inside the trap.
# IMPORTANT: Captures exit status FIRST so generate_quality_report cannot override it.
_QUALITY_REPORT_DONE=0
_quality_report_on_exit() {
  local _saved_exit=$?
  if [ "$_QUALITY_REPORT_DONE" = "1" ]; then
    exit $_saved_exit
    return
  fi
  _QUALITY_REPORT_DONE=1
  command -v generate_quality_report >/dev/null 2>&1 && generate_quality_report 2>/dev/null || true
  exit $_saved_exit
}
trap '_quality_report_on_exit' EXIT

PROJECT_ROOT="$(run_without_git_context git rev-parse --show-toplevel 2>/dev/null || echo "$(cd "$SCRIPT_DIR/../.." 2>/dev/null || echo "$SCRIPT_DIR/..")" )"
if [[ -d "$PROJECT_ROOT/node_modules/.bin" ]]; then
  export PATH="$PROJECT_ROOT/node_modules/.bin:$PATH"
fi

# Ensure pipe failures propagate exit codes through | head/tail/grep
set -o pipefail

