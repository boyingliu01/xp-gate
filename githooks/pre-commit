# Helper Functions
# ============================================================================

# Run a TypeScript entrypoint under tsx without routing arguments through the
# npx shim: Windows cmd.exe caps command lines at 8191 chars and long staged
# file lists (Boy Scout, build integrity) overflow it, turning a healthy run
# into a false BLOCK. Prefer the repo-local tsx CLI driven by node directly;
# keep npx as fallback for consumer repos relying on a global install.
# RUN_TSX_TIMEOUT (e.g. "120s") wraps the invocation in `timeout`.
if ! declare -F run_tsx >/dev/null 2>&1; then
  run_tsx() {
    local _root="${PROJECT_ROOT:-$(pwd)}" _timeout=()
    if [ -n "${RUN_TSX_TIMEOUT:-}" ]; then
      _timeout=(timeout "$RUN_TSX_TIMEOUT")
    fi
    if [ -f "$_root/node_modules/tsx/dist/cli.mjs" ] && command -v node >/dev/null 2>&1; then
      "${_timeout[@]}" node "$_root/node_modules/tsx/dist/cli.mjs" "$@"
    else
      "${_timeout[@]}" npx tsx "$@"
    fi
  }
fi

# Run a repo-local Node CLI (eslint, vitest, biome, ...) without npx when the
# binary is already in this repo's node_modules.
#
# `npx <tool>` costs ~1.4-1.5 s more than the tool itself on this machine
# (measured: eslint --version 1654 ms via npx vs 348 ms direct; vitest 1799 ms vs
# 250 ms). That is npm resolving the package before it ever runs: on a cold
# cache it may reach the network, which a quality gate must never depend on.
# pre-commit invokes these tools a handful of times per commit, so the wrapper
# was paying several seconds to start processes that were already installed.
#
# `run_node_bin <tool> <node-entry> [args...]`. Falls back to npx when the local
# entry is absent (a globally-installed toolchain is still a valid setup).
#
# The npx fallback is correct for RUNNING a tool but wrong for DETECTING one:
# `npx <tool> --version` downloads the package when it is missing, so it always
# succeeds and answers a question about the local environment by installing into
# it. Gate 5 used exactly that as its "is vitest available?" probe, so on a repo
# with no vitest it ran a downloaded vitest, failed on a missing
# @vitest/coverage-v8, and reported "TESTS FAILED" -- while no test had run.
#
# `--probe` (as the first argument, before the tool) restricts the lookup to the
# project's own node_modules and returns 127 when absent, which is the honest
# answer. Every detection site uses it; real runs keep the npx fallback, so a
# project relying on a global toolchain behaves as before.
if ! declare -F run_node_bin >/dev/null 2>&1; then
  run_node_bin() {
    local _probe=0
    if [ "$1" = "--probe" ]; then
      _probe=1
      shift
    fi
    local _tool="$1" _entry="$2"
    shift 2
    local _root="${PROJECT_ROOT:-$(pwd)}"
    local _local="$_root/node_modules/$_entry"
    if [ -f "$_local" ] && command -v node >/dev/null 2>&1; then
      node "$_local" "$@"
    elif [ "$_probe" -eq 1 ]; then
      return 127
    else
      npx "$_tool" "$@"
    fi
  }
fi

# Gate 5's vitest exit-code judgement (is_runner_infrastructure_error,
# is_partial_threshold_only_exit, handle_test_failure) is sourced from
# lib/test-failure.sh below, next to the other hook libraries.

# Parse LCOV file and return coverage percentage
# Usage: parse_lcov_coverage <lcov_file>
# Returns: coverage percentage (e.g., "85.5")
parse_lcov_coverage() {
  local lcov_file="$1"
  local total_lines=0
  local covered_lines=0
  
  if [ ! -f "$lcov_file" ]; then
    echo "0"
    return
  fi
  
  # Extract LF (Lines Found) and LH (Lines Hit) from lcov.info
  while IFS= read -r line; do
    case "$line" in
      LF:*)
        total_lines=$(echo "$line" | sed 's/LF://')
        ;;
      LH:*)
        covered_lines=$(echo "$line" | sed 's/LH://')
        ;;
    esac
  done < "$lcov_file"
  
  if [ "$total_lines" -gt 0 ]; then
    # Calculate percentage using awk for floating point
    awk "BEGIN {printf \"%.1f\", ($covered_lines / $total_lines) * 100}"
  else
    echo "0"
  fi
}

# Run command in subdirectory if PROJECT_SUBDIR is set
# Usage: run_in_subdir <command>
run_in_subdir() {
  local cmd="$1"
  
  if [ -n "$PROJECT_SUBDIR" ] && [ "$PROJECT_SUBDIR" != "." ]; then
    # Run command in subdirectory, then return to original directory
    # #392-#10: guard cd/pushd so a missing directory cannot run the gate in
    # the wrong cwd.
    if pushd "$PROJECT_SUBDIR" > /dev/null 2>&1; then
      eval "$cmd"
      local exit_code=$?
      popd > /dev/null 2>&1
      return $exit_code
    fi
    return 1
  else
    # Run in current directory
    eval "$cmd"
    return $?
  fi
}

# Check if file exists in subdirectory
# Usage: file_exists_in_subdir <filename>
file_exists_in_subdir() {
  local filename="$1"
  
  if [ -n "$PROJECT_SUBDIR" ] && [ "$PROJECT_SUBDIR" != "." ]; then
    [ -f "$PROJECT_SUBDIR/$filename" ]
  else
    [ -f "$filename" ]
  fi
}

