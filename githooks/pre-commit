#!/bin/bash
_LE_CR=$(tr -cd '\r' < "$0" | wc -c | tr -d '[:space:]'); test "${_LE_CR:-0}" -eq 0 || { printf '%s\n' "======================================================================" "FATAL: hook has CRLF line endings -- bash cannot parse it (#546)." "  file: $0" "  fix : tr -d '\\r' < \"$0\" > \"$0.tmp\" && mv \"$0.tmp\" \"$0\" && chmod +x \"$0\"" "Or re-sync the installed copy: xp-gate doctor --sync-hooks" "======================================================================" >&2; exit 1; }
#
# The line above is the #546 line-ending self-check. It MUST stay on the first
# executable line, as a SINGLE physical line, using no construct whose keyword
# needs a line boundary. All three are load-bearing:
#
#  * A CRLF rewrite puts \r at the end of EVERY line. Any construct whose
#    keywords must match across lines -- if/then/fi, case/esac, for/do/done --
#    then fails to PARSE and none of it runs. The original #546 implementation
#    was a nested if/fi spanning 11 lines: it could not survive the very
#    condition it detects. On a CRLF copy bash reported
#        line 76: syntax error near unexpected token `$'{\r''
#    blaming an innocent function far below -- which is exactly the failure #546
#    set out to prevent. It looked correct locally only because that bash build
#    deferred the error past the first command.
#  * Even on one line, `if ... then ... fi` ends in `fi\r`, and `then\r` / `fi\r`
#    are ordinary words to the tokenizer. So the check uses only
#    `test ... || { ...; exit 1; }`: the `{` already follows `; `, so a trailing
#    \r on the line cannot change how it tokenizes.
#  * The CR count is byte-wise (`tr -cd`). `grep -c $'\r'` reports 0 matches
#    through the Git-Bash/MSYS layer even on files that carry CR bytes, which is
#    what made earlier attempts at this fixture look green while CI stayed red.
#
# Verified: an LF copy runs through (0 CR bytes); a CRLF copy prints the FATAL
# diagnosis and exits 1 with no syntax error.
# OpenCode Quality Gates - Pre-Commit Hook - 12 numbered gates (Gate 0–11)
# 
# DESIGN PRINCIPLE: Tool unavailable = SKIP (graceful degradation), tool available + check fails = BLOCK
# Missing tools do NOT block the commit — the gate degrades to SKIP. Block fires only when
# the tool exists AND the check fails. This prevents broken toolchains from blocking work.
#
# Sourced from adapter-common.sh and language-specific adapters

# Source the common adapter functions — 3-tier resolution:
# 1. Global: ~/.config/xp-gate/adapters (for core.hooksPath global setup)
# 2. Project-local: <repo>/githooks/ (for per-project init)
# 3. Script dir: hooks directory containing this script (fallback)
# ── #640: wall-clock start, written into the per-run report ──────────────────
# The gate journal records every gate's verdict but no timing, so a slow commit
# could not be attributed: the #640 measurement found ~11s per commit outside any
# gate and had no instrument to say where it went. One timestamp at entry and one
# subtraction at report-write time turns "it feels slow" into a number.
#
# Milliseconds come from /proc/uptime when readable (bash's %3N is not portable to
# the bash 3.2 / MSYS builds this hook supports); otherwise whole seconds, which
# is coarse but still separates "gates are slow" from "the hook around them is".
_XP_HOOK_START_MS=""
if [ -r /proc/uptime ]; then
  _xp_up=$(cut -d' ' -f1 /proc/uptime 2>/dev/null || echo "")
  case "$_xp_up" in
    *.*) _XP_HOOK_START_MS=$(printf '%s%s' "${_xp_up%%.*}" "$(printf '%s' "${_xp_up#*.}" | cut -c1-3)") ;;
  esac
fi
case "$_XP_HOOK_START_MS" in
  ''|*[!0-9]*) _XP_HOOK_START_MS=$(( $(date +%s) * 1000 )) ;;
esac
export _XP_HOOK_START_MS
# #609: 1-based attempt index for this hook run. One hook invocation is one attempt,
# so every gate recorded during it shares the same index. Left empty by default so a
# caller that genuinely does not know the index omits the field instead of guessing.
