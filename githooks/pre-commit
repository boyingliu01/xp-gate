# Audit/Timing helpers — must be defined BEFORE first gate call (line ~197)
# Bash executes top-to-bottom; gate_start_ms + record_gate_audit are called
# in every gate, so their definitions lead the first call.
# ============================================================================
AUDIT_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# PROJECT_ROOT is resolved once above (line ~235); re-running `git rev-parse` here
# costs another ~90ms fork on every commit for the same answer (#640).
PROJECT_ROOT_FOR_AUDIT="${PROJECT_ROOT:-$(cd "$AUDIT_SCRIPT_DIR/../.." 2>/dev/null && pwd)}"

# Audit attribution safety net: if a previous commit's post-commit never fired
# (hooks skipped, crash, or an earlier --no-verify), its staged entries are
# still in .xp-gate/audit.pending.jsonl. Flush them now, stamped with the commit
# they actually belong to (`git log -1`), so they land under a real commit
# instead of accumulating or being stamped with THIS run's hash later. Runs
# before any gate so the flush is never counted in this commit's timings.
# Best-effort and silent: audit must never affect the commit's outcome.
if [ -f "$PROJECT_ROOT_FOR_AUDIT/.xp-gate/audit.pending.jsonl" ] \
   && [ -f "$PROJECT_ROOT_FOR_AUDIT/src/npm-package/lib/gate-audit.ts" ]; then
  _audit_prev_hash="$(git log -1 --format=%H 2>/dev/null || true)"
  if [ -n "$_audit_prev_hash" ] && [ -f "$PROJECT_ROOT_FOR_AUDIT/node_modules/tsx/dist/cli.mjs" ] \
     && command -v node >/dev/null 2>&1; then
    node "$PROJECT_ROOT_FOR_AUDIT/node_modules/tsx/dist/cli.mjs" \
      "$PROJECT_ROOT_FOR_AUDIT/src/npm-package/lib/gate-audit.ts" flush-pending \
      --commit-hash "$_audit_prev_hash" >/dev/null 2>&1 || true
  fi
  unset _audit_prev_hash
fi

# Issue #535: a failed `source` used to print one stderr line and keep going,
# so a missing lib silently removed gate logic from the run while every gate
# still reported PASS. Fail closed instead: abort with FATAL when the file is
# absent or its body exits non-zero while being sourced. `exit` inside a
# sourced file exits the SOURCING shell, so an `if ! source` wrapper cannot
# catch it — trap EXIT for the duration of the source instead.
source_gate_lib() {
  local lib_file="$1"
  if [ ! -f "$lib_file" ]; then
    echo "FATAL: cannot load $lib_file (missing)" >&2
    exit 1
  fi
  # Marker the EXIT trap compares against: only a source that never reached
  # its end counts as a load failure. A lib calling `exit` at top level would
  # otherwise be misread as a crash after it already did its job.
  SOURCE_GATE_LIB_COMPLETED=""
  local prev_trap=""
  prev_trap="$(trap -p EXIT || true)"
  # shellcheck disable=SC2064  # expand lib_file NOW: it is the failure target
  trap "[ -n \"\$SOURCE_GATE_LIB_COMPLETED\" ] || { echo 'FATAL: cannot load $lib_file (source failed)' >&2; exit 1; }" EXIT
  # shellcheck disable=SC1090  # sourcing the resolved lib is the contract here
  source "$lib_file"
  SOURCE_GATE_LIB_COMPLETED=1
  eval "$prev_trap"
}

