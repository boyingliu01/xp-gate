{
  "name": "@boyingliu01/dsh-plugin-xp-gate",
  "version": "0.35.1",
  "description": "XP-Gate deterministic quality gates + AI workflow skills as a DeepSeek Harness (DSH) native plugin: gate-check / gate-principles / gate-arch tools + 12 SKILL.md skills",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/boyingliu01/xp-gate",
    "directory": "plugins/dsh"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "skills/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-client.cjs",
    "check": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepare-skills": "node scripts/prepack.cjs",
    "prepack": "npm run build && npm run prepare-skills"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-shell": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-skill": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-shell": "0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^25.6.0",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1",
    "yaml": "^2.9.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "xp-gate",
    "quality-gates",
    "code-review",
    "sprint-flow"
  ],
  "author": "boyingliu01",
  "license": "MIT"
}
