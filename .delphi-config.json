{
  "active_profile": "default",
  "profiles": {
    "whalecloud": {
      "provider": "whalecloud",
      "providers": {
        "whalecloud": {
          "base_url": "https://lab.iwhalecloud.com/gpt-proxy",
          "api_key": "${WHALECLOUD_API_KEY}"
        }
      },
      "experts": {
        "architecture": {
          "provider": "whalecloud",
          "model": "g-glm-5.3-flash",
          "max_tokens": 32000
        },
        "technical": {
          "provider": "whalecloud",
          "model": "g-qwen3.8-flash"
        },
        "feasibility": {
          "provider": "whalecloud",
          "model": "g-deepseek-flash"
        }
      },
      "consensus": {
        "threshold_percent": 90,
        "max_review_rounds": 5,
        "distinct_models_required": true
      }
    },
    "default": {
      "providers": {
        "dashscope": {
          "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
          "api_key": "${DASHSCOPE_API_KEY}"
        },
        "zhipu": {
          "base_url": "https://open.bigmodel.cn/api/paas/v4",
          "api_key": "${ZHIPU_API_KEY}"
        },
        "deepseek": {
          "base_url": "https://api.deepseek.com/v1",
          "api_key": "${DEEPSEEK_API_KEY}"
        }
      },
      "experts": {
        "architecture": {
          "provider": "dashscope",
          "model": "qwen-3.8-max-preview"
        },
        "technical": {
          "provider": "zhipu",
          "model": "glm-5.2"
        },
        "feasibility": {
          "provider": "deepseek",
          "model": "deepseek-v4-pro"
        }
      }
    }
  },
  "consensus": {
    "threshold_percent": 90,
    "max_review_rounds": 5,
    "distinct_models_required": true
  }
}
